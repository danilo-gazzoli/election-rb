# Copy to .env, fill locally and never commit secrets.
PUBLIC_HOST=eleicao.example.org
DB_NAME_PROD=election_school
DB_USERNAME=election
DB_PASSWORD=replace-with-a-generated-local-password
SECRET_KEY_BASE=replace-with-the-output-of-bundle-exec-rails-secret
API_IMAGE=election-api
RELEASE_TAG=f12-local
# Replace with the independent frontend release build before the pilot.
FRONTEND_DIST=../../frontend-voting
BACKUP_DIR=./backups
OPS_UID=1000
OPS_GID=1000
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
